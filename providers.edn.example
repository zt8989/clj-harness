;; The NAMED REGISTRY. Each key is a provider name; config.edn's :provider
;; (or a run's request) picks one, and per-field overrides on top of it
;; tune individual fields without minting a new entry.
;;
;; The four fields are :protocol, :base-url, :model, :reasoning-effort.
;; Anything not named at a given tier falls through to the tier below.
;;
;; Sessions can also override these mid-flight through the session-configure
;; tool (after human approval); see README.

{:cheap {:protocol :openai-completions
         :base-url "https://openrouter.ai/api/v1"
         :model "nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free"}

 :smart {:protocol :openai-completions
         :base-url "https://openrouter.ai/api/v1"
         :model "anthropic/claude-sonnet-4.5"
         :reasoning-effort "high"}
         ;; ^ reasoning-effort is a Free/DeepSeek convention: the
         ;; llm/stream! implementation forwards it as a top-level
         ;; OpenAI field; ignored by APIs that don't support it.

 :local {:protocol :openai-completions
         :base-url "http://localhost:11434/v1"
         :model "qwen3"}}
         ;; ^ no api-key needed for a local endpoint; .env's HARNESS_API_KEY
         ;; is still resolved but not used when base-url is on localhost
         ;; (the protocol module decides).

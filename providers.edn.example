;; The PROVIDER CATALOG: which vendors this harness can reach, and which models
;; each one serves.
;;
;; A provider is a VENDOR -- one protocol, one endpoint -- and it lists the
;; models reachable there:
;;
;;   {:openrouter {:protocol :openai-completions
;;                 :base-url "https://openrouter.ai/api/v1"
;;                 :model    "anthropic/claude-sonnet-4.5"   ; the default model id
;;                 :models   {"anthropic/claude-sonnet-4.5" {:input #{:text :image}
;;                                                            :output #{:text}}
;;                            "deepseek/deepseek-chat"      {:input #{:text}
;;                                                            :output #{:text}}}}}
;;
;; :model is the id served unless a tier picks another one, and it must be a key
;; of :models. :input / :output are REQUIRED of every model, and the vocabulary
;; is what this harness can actually move:
;;
;;   :input   :text and/or :image    (a model declaring :audio is claiming a
;;                                    capability the wire cannot deliver)
;;   :output  :text only             (harness reads text, reasoning and tool
;;                                    calls out of a response, and nothing else)
;;
;; THIS FILE IS OPTIONAL. A config.edn naming a provider from the built-in table
;; (harness.models) needs no file here, and a config.edn that describes its
;; provider inline -- {:protocol .. :base-url .. :model ..} -- needs neither.
;; What you write here is merged OVER the built-in table: same provider field by
;; field, same provider's :models model by model. Your entries win.
;;
;; Every entry is validated whenever the file is read, so a malformed one fails on
;; the next run BY NAME rather than quietly serving something else.
;;
;; NOT READ, NOT MIGRATED: the old shape, where a provider carried a bare :model
;; string and no :models table (a provider that WAS a model). It fails by name
;; and says what to write instead.

{:openrouter
 {:protocol :openai-completions
  :base-url "https://openrouter.ai/api/v1"
  :model    "anthropic/claude-sonnet-4.5"
  :models   {"anthropic/claude-sonnet-4.5" {:input #{:text :image} :output #{:text}}
             "anthropic/claude-haiku-4.5"   {:input #{:text :image} :output #{:text}}
             "deepseek/deepseek-chat"       {:input #{:text}       :output #{:text}}
             "openai/gpt-4o-mini"           {:input #{:text :image} :output #{:text}}}}

 :local
 {:protocol :openai-completions
  :base-url "http://localhost:11434/v1"   ; ollama, or any OpenAI-compatible
  :model    "qwen3"                       ; endpoint you run yourself
  :models   {"qwen3"    {:input #{:text}       :output #{:text}}
             "qwen3-vl" {:input #{:text :image} :output #{:text}}}}}

;; A LOCAL ENDPOINT NEEDS NO KEY, but harness.memory still resolves
;; HARNESS_API_KEY (from .env, then the environment) and attaches it -- the
;; protocol module decides whether to use it. Nothing to configure for localhost.
;;
;; reasoning-effort is NOT a provider field. It is one of the three knobs a tier
;; chooses (:provider / :model / :reasoning-effort), so it belongs in config.edn
;; or in the session-configure tool call, not here.

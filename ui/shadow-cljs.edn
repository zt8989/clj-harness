{
 ;; src/ is TypeScript now, so the :app build is gone and with it the helix
 ;; dependency and the Vite bridge (vite-plugin-cljs.js). What is left is the
 ;; suite of ClojureScript test cases under test/ -- they drive @ag-ui/client
 ;; directly, never the page, which is what keeps them usable as a regression net
 ;; while the UI is rewritten. They move to TypeScript in ticket 02, and this file
 ;; goes with them.
 :source-paths ["test"]

 :builds
 {;; The test build.
  ;;
  ;; :node-library, not :node-test: shadow's :node-test target owns the whole
  ;; run (it discovers namespaces, runs them and calls process.exit), and vitest
  ;; owns the run here. What vitest needs is a module it can call a test from,
  ;; one at a time, and that is what :node-library's :exports produce.
  ;;
  ;; The output is .cjs, and that extension is the ONE place in ui/ where the
  ;; choice is not free: this package is "type": "module", so a .js file would be
  ;; parsed as ESM and the UMD wrapper shadow emits for :node-library would fail
  ;; on `__dirname is not defined in ES module scope`. Everything else under ui/
  ;; is plain .js (ESM), and the test driver imports this bundle across the
  ;; language boundary -- see ui/test/cljs.test.js.
  ;;
  ;; :load-tests, because the compiler DROPS `deftest` entirely unless it is on.
  ;; It defaults to true in dev mode but FALSE in :release (see shadow's release
  ;; defaults), which is why the build is driven by `compile` rather than
  ;; `release` -- and why the option is also stated here: relying on a mode
  ;; default for the one setting that decides whether the tests exist at all is
  ;; how a suite silently becomes zero tests.
  :test {:target :node-library
         :js-options {:js-provider :require}
         :compiler-options {:load-tests true}
         :output-to "cljs-test/tests.cjs"
         :exports {:tests harness.ui.test-runner/tests
                   :run   harness.ui.test-runner/run}}}}
